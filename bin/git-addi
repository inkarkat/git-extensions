#!/bin/bash
set -o pipefail

printUsage()
{
    cat <<HELPTEXT
Add unstaged changes from already staged files; update stage.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[--] [<pathspec>...] [-?|-h|--help]'
}

typeset -a addCommand=('add')
typeset -a allargs=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printUsage "$0"; exit 0;;
	--no-color|--color=*)
			shift;;
	--color)	shift; shift;;
	--edit|--patch)	addCommand+=("$1"); shift;;
	--force|-f)	addCommand+=("$1"); shift;;
	--)		break;;
	*)		allargs+=("$1"); shift;;
    esac
done
set -- "${allargs[@]}" "$@"

typeset -a stagedFilespecs=()
while IFS=$'\n' read -r filespec
do
    [ -r "$filespec" ] && stagedFilespecs+=("$filespec")
done < <(git-staged "$@")
[ ${#stagedFilespecs[@]} -gt 0 ] || exit 99

git "${addCommand[@]}" "${stagedFilespecs[@]}" \
    && git status -sb
