#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Rebase my commits on top of where the tip of the branch was second-last; same as
"rebase @{1}".
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[REBASE-ARGS ...] [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

exec git-branch-command --keep-position rev-range --with-range ' ' --revision '@{2}' --end-revision BRANCH rebase "$@"
