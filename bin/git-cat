#!/bin/bash
set -o pipefail
shopt -qs nullglob

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" '[--previous] [-r|--revision] <commit> [--] <pathspec>... [-?|-h|--help]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Retrieve the contents of <pathspec> as it exists in <commit>.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --previous		Retrieve the commit prior to <commit> / HEAD^.
HELPTEXT
}

typeset -a allargs=()
unset files
revision=
commitSuffix=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--no-color|--color=*)
			shift;;
	--color)	shift; shift;;
	--revision|-r)	shift; revision="${1:?}"; shift;;
	--previous)	shift; commitSuffix='^';;
	--)		shift; typeset -a files=("$@"); set --; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		if [ -z "$revision" ]; then
			    revision="${1:?}"; shift
			else
			    break
			fi
			;;
    esac
done
if [ -z "${files+t}" ]; then
    # No files after -- captured yet; need to investigate parsed and
    # remaining args from behind for files.
    typeset -a files=()
    allargs+=("$@")
    while [ ${#allargs[@]} -ne 0 ]
    do
	lastArg="${allargs[-1]}"
	[ -e "$lastArg" ] || break

	if [ -d "$lastArg" ]; then
	    readarray -t containedFiles < <(git-ls --recursive --only-files -- "$lastArg")
	    files=("${containedFiles[@]}" "${files[@]}")
	else
	    files=("$lastArg" "${files[@]}")
	fi
	allargs=("${allargs[@]:0:${#allargs[@]}-1}")
    done
fi
if [ -z "$revision" ]; then
    echo 'ERROR: No <revision> passed.'
    echo
    printUsage "$0"
    exit 2
fi >&2

commitId=$(git-commitid "${revision}${commitSuffix}") || exit $?
readarray -t submodules < <(git-sublist --revision "$commitId")

catFile()
{
    local path="${1:?}"; shift
    for submodule in "${submodules[@]}"
    do
	if [[ "${path}/" =~ ^"${submodule}/"(.*)/$ ]]; then
	    # Note: It would be more efficient to collect all passed <pathspec>...
	    # inside that submodule and do a single recursive call with all of
	    # them, but this will likely be used mostly with single files,
	    # anyway.
	    # Another benefit of this implementation is that the tempfile collection and
	    # file counting can be managed by the initial invocation, as recursive calls
	    # only output a single (submodule's) file.
	    submoduleRef="$(git-subhash "$commitId" "$submodule")" || { status=$?; continue 2; }
	    (cd "$submodule" && exec "${BASH_SOURCE[0]}" "$submoduleRef" "${BASH_REMATCH[1]}")
	    return $?
	fi
    done

    git show "${commitId}:${path}"
}

status=0
case ${#files[@]} in
    0)	echo >&2 'ERROR: No <pathspec> passed.'
	exit 2
	;;
    1)	typeset -a pager=("${PAGER:-less}" --RAW-CONTROL-CHARS); [ -t 1 ] || pager=()
	eval 'catFile "${files[0]}"' \
	    "${pager:+|}" '"${pager[@]}"'
	;;
    *)	tempDirspec="$(mktemp --directory --tmpdir "$(basename -- "$0")-XXXXXX" 2>/dev/null || { dirspec="${TMPDIR:-/tmp}/$(basename -- "$0").$$$RANDOM"; mkdir --parents -- "$dirspec" && printf %s "$dirspec"; })" || exit 3
	[ "$DEBUG" ] || trap 'rm -rf "$tempDirspec" 2>/dev/null' EXIT
	[ "$PAGER" = smartless ] && PAGER=less	# smartless does not page small outputs that fit the terminal, but we explicitly want to page through each log with diff separately.
	let count=0
	for filespec in "${files[@]}"
	do
	    printf -v tempFilespec '%s/%04d-%s' "$tempDirspec" $((++count)) "$(basename -- "$filespec")"
	    catFile "$filespec" > "$tempFilespec" || status=$?
	done
	"${PAGER:-less}" --RAW-CONTROL-CHARS "${tempDirspec}"/* || status=$?
esac
exit $status
