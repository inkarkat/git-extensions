#!/bin/bash
set -o pipefail
shopt -qs extglob

: ${GIT_CHANGESETFILES_PERCENTAGE_THRESHOLD:=10}
: ${GIT_CHANGESETFILES_ORIGINAL_FILE_PREFIX='[01;37m'}
: ${GIT_CHANGESETFILES_ORIGINAL_FILE_SUFFIX='[0m'}
: ${GIT_CHANGESETFILES_REVISIONS_END=;}

readonly revisionRangeArgs="[-n|--count N|-r|--revision REVISION|--revisions REVISION1 [...] $GIT_CHANGESETFILES_REVISIONS_END|--since <date>|--max-count <number>|--range <range> [--range ...]]"
readonly allArgs="[-N|--no-percentage] [-%|--percentage-threshold PCT] [-a|--include-original-files|-d|--drop-original-files] $revisionRangeArgs"
readonly filterArgs='[-%|--percentage-threshold PCT] [-d|--drop-original-files]'
readonly formatArgs='[-N|--no-percentage] [-a|--include-original-files]'
getShortUsage()
{
    case "$1" in
	'') printf %s "$allArgs";;
	filter)
	    printf %s "$filterArgs";;
	format)
	    printf %s "$formatArgs";;
	revision-range)
	    printf %s "$revisionRangeArgs";;
	*)  echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2;;
    esac
}
getLongUsage()
{
    local topic="$1"; shift
    local hadTopic=
    case "$topic" in
	''|filter)
	    cat <<HELPTEXT
    --percentage-threshold|-% PCT
			Show only files with a correlation of at least PCT%.
    --drop-original-files|-d
			Omit the original files from the output.
HELPTEXT
	    hadTopic=t
	    ;;&
	''|format)
	    cat <<HELPTEXT
    --no-percentage|-N	Omit the percentage; just list the files.
    --include-original-files|-a
			Include the original files in the output without extra
			highlighting.
HELPTEXT
	    hadTopic=t
	    ;;&
	''|revision-range)
	    cat <<HELPTEXT
    --count|-n N	Use files modified in the N'th previous commit.
    --revision|-r REVISION
			Use files modified in REVISION.
    --revisions REVISION1 [...] $GIT_CHANGESETFILES_REVISIONS_END
			Use files modified in REVISION(s); all following
			arguments until an argument consisting of '$GIT_CHANGESETFILES_REVISIONS_END' is
			encountered.
    --since <date>	Use files modified since <date> (inclusive) instead of
			the last commit.
    --max-count <number>
			Use files modified in the last <number> commits instead
			of the last commit.
    --range <range>	Use files modified in the commits in <range>.
HELPTEXT
	    ;;&
	*)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
    esac
}
printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" "$allArgs [<log-options>] [<revision range>] [--] [<pathspec>...] [-?|-h|--help]"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Show files that often get changed in commits that modify files in <pathspec> /
the files affected by <commit>, and the correlation between the commits; 100%
means an affected file is included in every commit that touches a passed file;
0% means it's included in less than one commit out of hundred.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    getLongUsage ''
    cat <<HELPTEXT
Files are shown if correlation is at least ${GIT_CHANGESETFILES_PERCENTAGE_THRESHOLD}% / PCT.

RELATED COMMANDS:
- git-also (https://github.com/anvaka/git-also) prints the number of shared
  commits and a similarity measure of the files.
HELPTEXT
}

typeset -a revisionRanges=()
typeset -a gitLogArgs=()
isPercentage=t
filterCommand="s/.*/${GIT_CHANGESETFILES_ORIGINAL_FILE_PREFIX}&${GIT_CHANGESETFILES_ORIGINAL_FILE_SUFFIX}/"
option() { :; }
parameter() { :; }
parameterToSep() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
typeset -A understandsSubtopics=()
isUnderstandSubtopic() {
    [ $# -gt 0 -a ${#understandsSubtopics[@]} -gt 0 ] || return 0
    local subtopic; for subtopic
    do
	[ "${understandsSubtopics["$subtopic"]}" ] && return 0
    done
    return 1
}
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--understand-for)
			shift; understandsSubtopics["$1"]=t; shift;;
	--understands)	shift
			option() { isUnderstandSubtopic "$@" || exit 1; printf 1; exit 0; }
			parameter() { isUnderstandSubtopic "$@" || exit 1; printf 2; exit 0; }
			parameterToSep() { local argCnt="${1:?}"; shift; isUnderstandSubtopic "$@" || exit 1; printf $argCnt; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			;;

	--no-percentage|-N)
			shift; isPercentage=; option format;;
	--percentage-threshold|-%)
			shift; GIT_CHANGESETFILES_PERCENTAGE_THRESHOLD="$1"; shift; parameter filter;;
	--include-original-files|-a)
			shift; filterCommand=''; option format;;
	--drop-original-files|-d)
			shift; filterCommand='d'; option filter;;

	--count|-n)	shift
			if ! [[ "$1" =~ ^[0-9]+$ ]]; then
			    printUsage "$0" >&2
			    exit 2
			fi
			revisionRanges+=("HEAD~$(($1 - 1))")
			shift
			parameter revision-range
			;;
	--revision|-r)	shift; revisionRanges+=("${1:?}"); shift; parameter revision-range;;
	--revisions)	shift
			while [ $# -gt 0 -a "$1" != "$GIT_CHANGESETFILES_REVISIONS_END" ]
			do
			    revisionRanges+=("${1:?}"); shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --revisions must be concluded with '${GIT_CHANGESETFILES_REVISIONS_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			parameterToSep ${#revisionRanges[@]} revision-range
			;;
	--@(since|max-count)=*)
			revisionRanges+=("$1"); shift; option revision-range;;
	--@(since|max-count))
			revisionRanges+=("$1" "${2?}"); shift; shift; parameter revision-range;;
	--range=*)	revisionRanges+=("${1#--range=}"); shift;;
	--range)	shift; revisionRanges+=("${1:?}"); shift;;

	--)		gitLogArgs+=("$1"); shift; endOfOptionsAndParameters; break;;
	*)		gitLogArgs+=("$1"); shift; endOfOptionsAndParameters;;
    esac
done

removeStatus()
{
    sed	\
	-e '/^$/d' \
	-e 's/^[CR][^	]*	//' \
	-e 't splitRename' \
	-e 's/^[^	]\+	//' \
	-e ':splitRename' \
	-e 's/^\(.*\)	\(.*\)$/\1\n\2/'
}

logFiles()
{
    local prettyArg="${1:?}"; shift
    git-logv "$prettyArg" "${revisionRanges[@]}" "${gitLogArgs[@]}" "$@"
}
extractChangesetFiles()
{
    if [ "$isPercentage" ] || [ $GIT_CHANGESETFILES_PERCENTAGE_THRESHOLD -gt 0 ]; then
	logFiles --pretty=format:--- "$@" \
	    | removeStatus \
	    | awk -v "isPercentage=$isPercentage" -v percentageThreshold="$GIT_CHANGESETFILES_PERCENTAGE_THRESHOLD" '
BEGIN {
    PROCINFO["sorted_in"] = "@val_num_desc"
}
/^---$/ {
    ++commitCnt
    next
}
{
    ++fileCnt[$0]
}
END {
    for (file in fileCnt) {
	percentage = 100 * fileCnt[file] / commitCnt
	if (percentage >= percentageThreshold) {
	    if (isPercentage) {
		printf("%3d%%\t%s\n", percentage, file)
	    } else {
		printf("%s\n", file)
	    }
	}
    }
}
'
    else
	logFiles --pretty= "$@" \
	    | removeStatus \
	    | sort --unique
    fi
}

if [ -n "$filterCommand" ]; then
    originalFilePrefixPattern='^'; [ $GIT_CHANGESETFILES_PERCENTAGE_THRESHOLD -gt 0 ] && originalFilePrefixPattern='^ *[0-9]\+%	'
    typeset -a filterPipeline=()
    while IFS=$'\n' read -r literalOriginalPathspec
    do
	pathspecAnchor='$'
	if [[ "$literalOriginalPathspec" =~ /$ ]]; then
	    pathspecAnchor=''
	elif [ -d "$literalOriginalPathspec" ]; then
	    literalOriginalPathspec+='/'
	    pathspecAnchor=''
	fi

	[ ${#filterPipeline[@]} -eq 0 ] && filterPipeline+=(sed)
	filterPipeline+=(-e "/${originalFilePrefixPattern}${literalOriginalPathspec}${pathspecAnchor}/${filterCommand}")
    done < <(
	git-showfiles "${revisionRanges[@]}" "${gitLogArgs[@]}" "$@" 2>/dev/null \
	    | sed -e 's/[][\$*.^/]/\\&/g'
	)

fi

typeset -a pager=("${PAGER:-less}" --RAW-CONTROL-CHARS); [ -t 1 ] || pager=()
eval 'extractChangesetFiles "$@"' \
    "${filterPipeline:+|}" '"${filterPipeline[@]}"' \
    "${pager:+|}" '"${pager[@]}"'
