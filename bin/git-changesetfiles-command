#!/bin/sh

GIT_SHOWFILES_COMMAND="${GIT_CHANGESETFILESCOMMAND_PREFIX_COMMAND}${GIT_CHANGESETFILESCOMMAND_PREFIX_COMMAND:+ }changesetfiles --no-percentage --include-original-files${GIT_CHANGESETFILESCOMMAND_SUFFIX_ARGS:+ }${GIT_CHANGESETFILESCOMMAND_SUFFIX_ARGS}" \
GIT_SHOWFILES_UNDERSTANDS_COMMAND='changesetfiles --understand-for filter --understand-for for-range' \
GIT_SHOWFILES_WHAT="files that often get changed in commits that modify ${GIT_CHANGESETFILESCOMMAND_WHAT:-files (inside <pathspec>)}" \
exec git-showfiles-command "$@"
