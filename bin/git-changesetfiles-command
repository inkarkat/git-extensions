#!/bin/sh

GIT_SHOWFILES_COMMAND='changesetfiles --no-percentage --include-original-files' \
GIT_SHOWFILES_UNDERSTANDS_COMMAND='changesetfiles --understand-for filter --understand-for for-range' \
GIT_SHOWFILES_WHAT='files that often get changed in commits that modify files (inside <pathspec>)' \
exec git-showfiles-command "$@"
