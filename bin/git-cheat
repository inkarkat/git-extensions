#!/bin/bash

readonly scriptDir=$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 2)
[ -d "$scriptDir" ] || { echo >&2 "ERROR: Cannot determine script directory!"; exit 2; }
readonly projectDir="${scriptDir}/.."
readonly cheatsDir="${projectDir}/etc/cheats"

: ${GIT_CHEAT_FILE_PREFIX:=gitcheats}

typeset -a pager=()
if [ -t 1 ]; then
    if type -t -- glow >/dev/null; then
	exec glow --pager "${cheatsDir}/${GIT_CHEAT_FILE_PREFIX}${1:+"-$1"}.md"
    else
	pager=("${PAGER:-less}" --RAW-CONTROL-CHARS)
    fi
fi
eval 'cat "${cheatsDir}/${GIT_CHEAT_FILE_PREFIX}${1:+"-$1"}.md"' \
    "${pager:+|}" '"${pager[@]}"'
