#!/bin/bash

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" "[--previous] [-f|--force] [--accept-single|--single-only] [--filter ''|FILTER] ([-r|--revision] <commit>) [N [M ...]] [--] [<pathspec>...] [-?|-h|--help]"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Interactively select (from files modified in <commit> / HEAD) files (or directly
pass N, M, ... selections) to be reverted to what the content in the passed
<commit> was.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --previous		Revert to what the content in the commit prior to the
			passed <commit> was.
HELPTEXT
}

rev=
commitSuffix=
checkoutrevisionCommand="${GITCHECKOUTREVISIONSELECTED_COMMAND:-checkoutrevision}"
typeset -a selectedCommandArgs=()
typeset -a allargs=()
unset filespecs
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--no-color|--color=*)
			shift;;
	--color)	shift; shift;;

	--previous)	checkoutrevisionCommand+=" $1"; shift; commitSuffix='^';;
	--force|-f)	checkoutrevisionCommand+=" $1"; shift;;
	--revision|-r)	shift; rev="${1:?}"; shift;;
	--accept-single|--single-only)
			selectedCommandArgs+=("$1"); shift;;
	--filter)	selectedCommandArgs+=("$1" "$2"); shift; shift;;
	--)		shift; typeset -a filespecs=("$@"); set --; break;;
	*)		if [ -z "$rev" ] && rev="$(git-commitid --no-error -- "$1")"; then
			    :
			else
			    allargs+=("$1")
			fi
			shift
			;;
    esac
done
if [ -z "${filespecs+t}" ]; then
    # No files after -- captured yet; need to investigate parsed and
    # remaining args from behind for files.
    typeset -a filespecs=()
    allargs+=("$@")
    while [ ${#allargs[@]} -ne 0 ]
    do
	lastArg="${allargs[-1]}"
	[ -e "$lastArg" ] || break

	filespecs=("$lastArg" "${filespecs[@]}")
	allargs=("${allargs[@]:0:${#allargs[@]}-1}")
    done
fi
quotedFilespecs=; [ ${#filespecs[@]} -eq 0 ] || printf -v quotedFilespecs '%q ' "${filespecs[@]}"
quotedFilespecs="${quotedFilespecs% }"

printf -v quotedRev '%q' "${rev:-HEAD}"
export GIT_SELECTED_COMMAND_DEFAULT_FILES="git-showfiles ${quotedRev}${commitSuffix} -- $quotedFilespecs"
exec git-selected-command "${selectedCommandArgs[@]}" "$checkoutrevisionCommand --revision $quotedRev -- $quotedFilespecs" "${allargs[@]}"
