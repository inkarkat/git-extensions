#!/bin/bash

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" '[--get|--disable|PLATFORM-INFO-COMMAND] [-?|-h|--help]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Set the locally / print the configured shell command that yields the commit
trailer $infoType for this repository.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --get		Only print the configured shell command (or nothing).
			Porcelain output: the command is printed without any
			additional text or formatting.
    --disable		Disable inclusion of the commit trailer $infoType in
			commit messages of this repository.
Example:
HELPTEXT
    local pic; for pic in 'aptitude --version | head -n 1' 'withCommandPrefix borgmatic --version' 'unprefix --exec sox --version \; "sox:      "'
    do
	printf "%q '%s'\n" "$(basename "$1")" "$pic"
    done
}

# A command that has no output disables the commit trailer and prevents
# configuration from higher scopes or environment variables to apply.
readonly NOOP_TRAILER_COMMAND='echo'

isDisabled()
{
    [ "$(get '')" = "$NOOP_TRAILER_COMMAND" ]
}

get()
{
    local isVerbose="${1?}"; shift

    local infoTrailerVariableName="GIT_COMMIT_TRAILER_${infoType^^}"
    local infoTrailerVariable="${!infoTrailerVariableName}"
    local infoTrailerConfig="$(git-wrapper config --get "$infoTrailerConfigName")"
    local infoTrailerSource
    if [ -z "$infoTrailerConfig" ]; then
	if [ -n "$infoTrailerVariable" ]; then
	    infoTrailer="$infoTrailerVariable"
	    infoTrailerSource="$infoTrailerVariableName"
	fi
    elif [ -n "$infoTrailerVariable" ] && [ -z "$(git config --local --get "$infoTrailerConfigName")" -a -z "$(git config --worktree --get "$infoTrailerConfigName")" ]; then
	# variable takes precedence over config in higher scopes.
	infoTrailer="$infoTrailerVariable"
	infoTrailerSource="$infoTrailerVariableName"
    else
	infoTrailer="$infoTrailerConfig"
	infoTrailerSource="$infoTrailerConfigName"
    fi
    if [ "$isVerbose" ]; then
	[ -n "$infoTrailer" ] \
	    && printf '%s (from %s)\n' "$infoTrailer" "$infoTrailerSource" \
	    || printf 'No commit trailer %s configured.\n' "$infoType"
    else
	[ -n "$infoTrailer" ] || return 1
	printf '%s\n' "$infoTrailer"
    fi
}

infoType='platform'
infoTrailerConfigName="commit.trailer.${infoType}"
case "$1" in
    --help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
    --get)		shift; get ''; exit $?;;
    --disable)		shift
			if isDisabled; then
			    printf >&2 'Commit trailer %s is already disabled.\n' "$infoType"
			    exit 99
			else
			    git-wrapper config set --local "$infoTrailerConfigName" "$NOOP_TRAILER_COMMAND" \
				&& printf 'Disabled commit trailer %s here.\n' "$infoType"
			    exit $?
			fi
			;;
esac
case $# in
    0)	if isDisabled; then
	    printf 'Commit trailer %s is disabled here.\n' "$infoType"
	    exit 4
	fi
	get t
	;;
    1)	infoCommand="${1:?}"; shift
	git-verboselocalconfig set "$infoTrailerConfigName" "$infoCommand"
	;;
    *)	printUsage "$0" >&2; exit 2;;
esac
