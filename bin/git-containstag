#!/bin/bash
set -o pipefail

LONGUSAGE=
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    $LONGUSAGE cat <<HELPTEXT
List tag(s) that are reachable from the passed <commit> / HEAD.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[<commit>] [-?|-h|--help]'
    $LONGUSAGE echo
    $LONGUSAGE cat <<HELPTEXT
Test whether TAG is reachable from the passed <commit>.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" "TAG <commit>|''"
}
printShortUsage()
{
    LONGUSAGE=: printLongUsage "$1"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}

case "$1" in
    --help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
    --no-color|--color=*)
			shift;;
    --color)		shift; shift;;
esac

listContainedTags()
{
    # Source: https://stackoverflow.com/a/39084124/813602
    git tag --merged "$@"
}
case $# in
    0|1)
	listContainedTags "$@";;
    2)
	listContainedTags "${2:-HEAD}" | grep --quiet --fixed-strings --line-regexp "${1:?}";;
    *)
	printUsage "$0" >&2
	exit 2
	;;
esac
