#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Retrieve the contents of <pathspec> as it exists in revision <commit> and save
it as <pathspec>.<revision> (or override with -O|--override, or <target> if
given).
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-O|--override] [-r|--revision] <commit> [--] (<pathspec> [to <target>]) [...] [-?|-h|--help]'
}

revision=
isOverride=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printUsage "$0"; exit 0;;
	--no-color|--color=*)
			shift;;
	--color)	shift; shift;;
	--revision|-r)	shift; revision="${1:?}"; shift;;
	--override|-O)	shift; isOverride=t;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		if [ -z "$revision" ]; then
			    revision="${1:?}"; shift
			else
			    break
			fi
			;;
    esac
done
if [ -z "$revision" ]; then
    echo 'ERROR: No <revision> passed.'
    echo
    printUsage "$0"
    exit 2
fi >&2

commitId=$(git-commitid "$revision") || exit $?

status=0
while [ $# -ne 0 ]
do
    path="$1"; shift

    if [ "$1" = to ]; then
	shift; target="$1"; shift
    elif [ "$isOverride" ]; then
	target="$path"
    else
	target="${path}.${revision}"
    fi

    git show "${commitId}:$path" > "$target" || status=$?
done
exit $status
