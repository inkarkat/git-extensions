#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Retrieve the contents of <pathspec> as it exists in revision <revision> and save
it as <pathspec>.<revision> (or override with -O|--override, or <target> if
given).
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-O|--override] <revision> [--] (<pathspec> [to <target>]) [...] [-?|-h|--help]'
}

isOverride=
case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
    --no-color|--color=*)
			shift;;
    --color)		shift; shift;;
    --override|-O)	shift; isOverride=t;;
esac
if [ $# -lt 2 ]; then
    printUsage "$0"
    exit 2
fi


revision="$1"; shift
[ "$1" = -- ] && shift
commitId=$(git-commitid "$revision") || exit $?

status=0
while [ $# -ne 0 ]
do
    path="$1"; shift

    if [ "$1" = to ]; then
	shift; target="$1"; shift
    elif [ "$isOverride" ]; then
	target="$path"
    else
	target="${path}.${revision}"
    fi

    git show "${commitId}:$path" > "$target" || status=$?
done
exit $status
