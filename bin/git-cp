#!/bin/bash

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-O|--override] [-r|--revision] <commit> [--] (<pathspec> [to <target>]) [...] [-?|-h|--help]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Retrieve the contents of <pathspec> as it exists in revision <commit> and save
it as <pathspec>.<revision> (or override with -O|--override, or <target> if
given).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
}

revision=
isOverride=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--no-color|--color=*)
			shift;;
	--color)	shift; shift;;
	--revision|-r)	shift; revision="${1:?}"; shift;;
	--override|-O)	shift; isOverride=t;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		if [ -z "$revision" ]; then
			    revision="${1:?}"; shift
			else
			    break
			fi
			;;
    esac
done
if [ -z "$revision" ]; then
    echo 'ERROR: No <revision> passed.'
    echo
    printUsage "$0"
    exit 2
fi >&2

commitId=$(git-commitid "$revision") || exit $?

status=0
while [ $# -ne 0 ]
do
    path="$1"; shift

    if [ "$1" = to ]; then
	shift; target="$1"; shift
    elif [ "$isOverride" ]; then
	target="$path"
    else
	target="${path}.${revision}"
    fi

    git show "${commitId}:$path" > "$target" || status=$?
done
exit $status
