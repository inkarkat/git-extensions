#!/bin/bash

LONGUSAGE=
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    $LONGUSAGE cat <<HELPTEXT
Test whether the last commit / <commit> is signed with a GPG key.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[<commit>] [-?|-h|--help]'
    $LONGUSAGE echo
    $LONGUSAGE cat <<HELPTEXT
Print the GPG signing information of the last commit / <commit>.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '--print [<commit>] [-?|-h|--help]'
}
printShortUsage()
{
    LONGUSAGE=: printLongUsage "$1"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}

action=testSigning
case "$1" in
    --help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
    --no-color|--color=*)
			shift;;
    --color)		shift; shift;;
    --print|-p)		shift; countArg=(); action=printSigning;;
esac
case $# in
    0)	commit=HEAD;;
    1)	commit="$1"; shift;;
    *)	printUsage "$0" >&2; exit 2;;
esac

querySigning()
{
    local format="${1:?}"; shift
    git show --pretty="format:$format" --no-patch "$commit"
}

testSigning()
{
    [ "$(querySigning '%G?')" != N ]
}

printSigning()
{
    querySigning '%GG'
}

$action
