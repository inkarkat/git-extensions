#!/bin/bash

typeset -ra scopeCommand=(rev-range-to-previous-stack --offset -1)
readonly scopeWhat='the additions of the branch preceding the current / passed via BRANCH in
the stack versus its previous stacked branch
(FOO-2 to FOO-1 when currently on FOO-3)'

readonly scriptDir="$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 3)"
[ -d "$scriptDir" ] || { echo >&2 'ERROR: Cannot determine script directory!'; exit 3; }
readonly projectDir="${scriptDir}/.."
readonly libDir="${projectDir}/lib/br-variants"

source "${libDir}/custom-range.sh"
