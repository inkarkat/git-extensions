#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Rebase the commits on this stacked branch on top of the master branch.
(After the previous stacked branch has been reintegrated into master.)
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[REBASE-ARGS ...] [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

exec git-master-command --keep-position ps-rb --onto MASTER "$@"
