#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Rebase my commits on top of the previous stacked branch.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[REBASE-ARGS ...] [-?|-h|--help]'
}

typeset -a allargs=()
typeset -a ontoArgs=(--onto PREVIOUSBRANCH)
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printUsage "$0"; exit 0;;
	--onto)		ontoArgs+=("$1" "${2:?}"); shift; shift;;
	--check|--command|--exec)
			allargs+=("$1"); shift; ontoArgs=();; # Don't move commits to a diverged previous stacked branch when we're just checking or executing commands.
	--)		allargs+=("$1"); shift; break;;
	*)		allargs+=("$1"); shift;;
    esac
done

exec git-rev-range-to-previous-stack --no-range ${GIT_REBASE_COMMAND:-rebase} "${ontoArgs[@]}" "${allargs[@]}" "$@"
