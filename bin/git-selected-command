#!/bin/bash

: ${GIT_SELECTEDCOMMAND_COMMAND_JOINER=;}
: ${GIT_SELECTEDCOMMAND_EXEC_END=;}

printUsage()
{
    cat <<HELPTEXT
Interactively select (from modified files or passed list of files) files (or
directly pass N, M, ... selections) by number to pass to GIT-COMMAND.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" "[--accept-single|--single-only] [--filter ''|FILTER] --command \"GIT-COMMANDLINE\" | --exec GIT-COMMAND [...] ${GIT_SELECTEDCOMMAND_EXEC_END} [SELECTION ...] [--] [ENTRIES] [-?|-h|--help]"
}

typeset -a commandOnSelectedArgs=()
preCommand=
commands=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printUsage "$0"; exit 0;;
	--accept-single|--single-only)
			commandOnSelectedArgs+=("$1"); shift;;
	--filter)	commandOnSelectedArgs+=("$1" "$2"); shift; shift;;
	-c)		printf -v cmd %q "${2?}"; preCommand+="$1 $cmd "; shift; shift;;
	--command)	shift; commands+="${commands:+ $GIT_SELECTEDCOMMAND_COMMAND_JOINER }$1"; shift;;
	--exec)		shift
			cmd=
			while [ $# -gt 0 -a "$1" != "$GIT_SELECTEDCOMMAND_EXEC_END" ]
			do
			    printf -v quotedArg %q "$1"
			    cmd+="${cmd:+ }${quotedArg}"
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --exec command must be concluded with '${GIT_SELECTEDCOMMAND_EXEC_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			commands+="${commands:+ $GIT_SELECTEDCOMMAND_COMMAND_JOINER }${cmd}"
			;;
	*)		break;;
    esac
done
if [ -z "$commands" ]; then
    echo "ERROR: No GIT-COMMAND specified; need to pass -c|--command \"GIT-COMMANDLINE\", or --exec GIT-COMMAND [...] $GIT_SELECTEDCOMMAND_EXEC_END"
    echo
    printUsage "$0"
    exit 2
fi >&2
generator="${GIT_SELECTED_COMMAND_DEFAULT_FILES-git-modified --}"

if type -t commandOnSelected >/dev/null; then
    # Delegate to external tool.
    exec commandOnSelected \
    "${commandOnSelectedArgs[@]}" \
    --generator "$generator" \
    --command "git-wrapper ${preCommand}${commands}" \
    -- "$@"
fi
# Fallback to simple implementation with select().


shopt -qs extglob
set -o noglob
IFS=$'\n'
typeset -a args=()
typeset -a selected=()
while [ $# -ne 0 ]
do
    case "$1" in
	--)		shift; break;;
	-*)		args+=("$1"); shift;;
	+([0-9]))	selected+=("$1"); shift;;
	*)		break;;
    esac
done
set -- $(eval "$generator" '"$@"')
if [ $# -eq 0 ]; then
    echo >&2 "No files to ${commands}."
    exit 124
fi

typeset -a selectedPaths=()
selectCandidates()
{
    local path; select path
    do
	if [ "$path" ]; then
	    selectedPaths+=("$path")
	elif [ "$REPLY" = '.' ]; then
	    break
	elif [ "$REPLY" = '?' ]; then
	    cat >&2 <<-'EOF'
		Enter each number (one after the other) to select the entry.
		Filter the list by entering "grep" arguments. (Double backslashes.)
		Conclude by pressing Ctrl-D or entering "."
EOF
	else
	    typeset -a filteredPaths=(); readarray -t filteredPaths < <(unset IFS; printf '%s\n' "$@" | grep $REPLY)
	    selectCandidates "${filteredPaths[@]}"
	    break
	fi
    done < "${USERQUERY_INPUT:-/dev/tty}"
}
selectByCounts()
{
    local count
    for count in "${selected[@]}"
    do
	if [ $count -gt $# ]; then
	    filePlural=s; [ $# -eq 1 ] && filePlural=
	    printf >&2 'Only %d file%s to %s.\n' "$#" "$filePlural" "$commands"
	    exit 2
	fi

	selectedPaths+=("${@:$count:1}")
    done
}

if [ ${#selected[@]} -eq 0 ]; then
    selectCandidates "$@"
else
    selectByCounts "$@"
fi

[ ${#selectedPaths[@]} -gt 0 ] || exit 125

eval "exec git-wrapper ${preCommand}${commands}" '"${args[@]}" "${selectedPaths[@]}"'
