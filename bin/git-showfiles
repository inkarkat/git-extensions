#!/bin/bash
set -o pipefail

: ${GIT_SHOWFILES_REVISIONS_END=;}

# Sources:
#   http://stackoverflow.com/questions/1552340/git-show-all-changed-files-between-two-commits
#   http://stackoverflow.com/questions/3144647/git-show-all-files-changed-between-two-commits

readonly scriptDir="$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 3)"
[ -d "$scriptDir" ] || { echo >&2 'ERROR: Cannot determine script directory!'; exit 3; }
readonly projectDir="${scriptDir}/.."
readonly libDir="${projectDir}/lib"
source "${libDir}/logArgParser.sh" || exit 3

readonly filterArgs='[-s|--short|-l|--long] [--[no-]renames] [-M<n>|--find-renames[=<n>]] [-C<n>|--find-copies[=<n>]|--find-copies-harder] ([-a|--added] [-c|--copied] [-d|--deleted] [-m|--modified] [-r|--renamed] [-t|--retyped] ... | [-A|--not-added] [-C|--not-copied] [-D|--not-deleted] [-M|--not-modified] [-R|--not-renamed] [-T|--not-retyped] ...)'
readonly formatArgs='[-s|--status]'
rangeArgs()
{
    local revisionRangeArgs="$(GIT_LOGARGPARSER_REVISIONS_END="$GIT_SHOWFILES_REVISIONS_END" getShowRangeArgsShortUsage)"
    echo "[--intermediate] ([--cached] [--to COMMIT])|<since>..<until>|${revisionRangeArgs//-r|--revision/--revision}"
}
getShortUsage()
{
    case "$1" in
	'') printf %s "$filterArgs $formatArgs $(rangeArgs)";;
	filter)
	    printf %s "$filterArgs";;
	format)
	    printf %s "$formatArgs";;
	range)
	    printf %s "$(rangeArgs)";;
	*)  echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2;;
    esac
}
getLongUsage()
{
    local topic="$1"; shift
    local hadTopic=
    case "$topic" in
	''|filter)
	    cat <<HELPTEXT
    --added|-a --copied|-c --deleted|-d --modified|-m --renamed|-r --retyped|-t
		    Only list added / copied / deleted / modified / renamed /
		    changed in type files (can be combined).
		    If you want renames / copies to be counted as added /
		    deleted, pass --no-renames.
    --not-added|-A --not-copied|-C --not-deleted|-D --not-modified|-M
    --not-renamed|-R --not-retyped|-T
		    Don't list added / copied / deleted / modified / renamed /
		    changed in type files (can be combined).
		    If you want renames / copies to be counted as added /
		    deleted, pass --no-renames.
HELPTEXT
	    hadTopic=t
	    ;;&
	''|format)
	    cat <<HELPTEXT
    -s|--status	    Include the status (added, modified, etc.) as a first
		    column.
HELPTEXT
	    hadTopic=t
	    ;;&
	''|range)
	    cat <<HELPTEXT
    --intermediate  Files that are again the same but were changed and then
		    changed back, are included, too. Requires a commit range.
HELPTEXT
	    GIT_LOGARGPARSER_REVISIONS_END="$GIT_SHOWFILES_REVISIONS_END" getShowRangeArgsLongUsage 'Show files'
	    hadTopic=t
	    ;;&
	*)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
    esac
}
printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" "$filterArgs $formatArgs $(rangeArgs) [[--] <pathspec>...] [-?|-h|--help]"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Show the files modified in passed commit or commit range.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    getLongUsage ''
}

typeset -a argsWithResolvedCommitIds=()
typeset -a logRange=()
range=
addRange()
{
    # XXX: Semantics of r1..r2 and r1...r2 are swapped between rev-range and
    # diff.
    #
    # For diff, r1..r2 is synonymous to r1 r2; i.e. changes between the two
    # commits are shown. r1...r2 views the changes on the branch containing
    # and up to the r2, starting at a common ancestor of both r1 and r2.
    # "git diff r1...r2" is equivalent to "git diff $(git merge-base r1 r2)
    # r2"
    #
    # For log / rev-parse, r1..r2 means reachable from r2 but not r1.
    # r1...r2 is the symmetric difference of r1 and r2 and is defined as r1
    # r2 --not $(git merge-base --all r1 r2). It is the set of commits that
    # are reachable from either one of r1 (left side) or r2 (right side) but
    # not from both.
    #
    # So, the symmetric one is ... for log, but .. for diff, and the one
    # that excludes changes from the first is .. for log but ... for diff.
    # WTF.
    case "${1:?}" in
	*...*)		logRange+=("$1"); range='..'; shift;;
	*..*)		logRange+=("$1"); range='...'; shift;;
	*)		resolvedCommitId="$(git-commitid -- "$1")" || exit 2; shift
			argsWithResolvedCommitIds+=("$resolvedCommitId")
			;;
    esac
}

typeset -a pager=("${PAGER:-less}" --RAW-CONTROL-CHARS); [ -t 1 ] || pager=()
typeset -a diffRange=()
isIncludeIntermediate=
typeset -a gitNameStatusArg=(--name-only)
typeset -a sortArgs=(-u)
statusFilter=
typeset -a allargs=()
typeset -a renameArgs=()
typeset -a prettyArgs=()
option() { :; }
parameter() { :; }
argCount() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
typeset -A understandsSubtopics=()
isUnderstandSubtopic() {
    [ $# -gt 0 -a ${#understandsSubtopics[@]} -gt 0 ] || return 0
    local subtopic; for subtopic
    do
	[ "${understandsSubtopics["$subtopic"]}" ] && return 0
    done
    return 1
}
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--understand-for)
			shift; understandsSubtopics["$1"]=t; shift;;
	--understands)	shift
			option() { isUnderstandSubtopic "$@" || exit 1; printf 1; exit 0; }
			parameter() { isUnderstandSubtopic "$@" || exit 1; printf 2; exit 0; }
			argCount() { local argCount="${1:?}"; shift; isUnderstandSubtopic "$@" || exit 1; printf $argCount; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			;;

	--cached)	diffRange+=("$1"); shift; option range;;
	--to)		shift; diffRange+=("${1:?}"); shift; option range;;
	--intermediate)	shift; isIncludeIntermediate=t; option range;;
	--status|-s)	shift; gitNameStatusArg=(--name-status); sortArgs=(-k 2 -u); option format;;
	--no-renames|--renames|--find-renames|--find-renames=*|-M?*|--find-copies|--find-copies=*|-C?*|--find-copies-harder)
			renameArgs+=("$1"); shift; option filter;;
	--pretty=*)	prettyArgs=("$1"); shift; option format;;
	--pretty)	prettyArgs=("$1" "${2?}"); shift; shift; option format;;
	--added|-a)	shift; statusFilter+='A'; option filter;;
	--not-added|-A)	shift; statusFilter+='a'; option filter;;
	--copied|-c)	shift; statusFilter+='C'; option filter;;
	--not-copied|-C)
			shift; statusFilter+='c'; option filter;;
	--deleted|-d)	shift; statusFilter+='D'; option filter;;
	--not-deleted|-D)
			shift; statusFilter+='d'; option filter;;
	--modified|-m)	shift; statusFilter+='M'; option filter;;
	--not-modified|-M)
			shift; statusFilter+='m'; option filter;;
	--renamed|-r)	shift; statusFilter+='R'; option filter;;
	--not-renamed|-R)
			shift; statusFilter+='r'; option filter;;
	--retyped|-t)	shift; statusFilter+='T'; option filter;;
	--not-retyped|-T)
			shift; statusFilter+='t'; option filter;;

	--range=*)	addRange "${1#--range=}"; shift; option range;;
	--range)	shift; addRange "${1:?}"; shift; parameter range;;
	*..*)		addRange "$1"; shift; option range;;

	--)		endOfOptionsAndParameters; break;;
	*)		argCount=0
			typeset -a parsedRangeArgs=()
			if GIT_LOGARGPARSER_REVISIONS_END="$GIT_WHOIS_REVISIONS_END" parseShowRangeArgsInto argCount parsedRangeArgs "$@"; then
			    logRange+=("${parsedRangeArgs[@]}")
			    argsWithResolvedCommitIds+=("${parsedRangeArgs[@]}")
			    shift $argCount
			    argCount $argCount
			elif argCount=$(countDiffArgs "$1"); then
			    shift $argCount
			    argCount $argCount
			else
			    endOfOptionsAndParameters; break
			fi
			;;
    esac
done
if [ ${#prettyArgs[@]} -eq 0 ]; then
    # Omit any commit message parts by default.
    prettyArgs=(--pretty='format:')
else
    # If custom commit message rendering is requested, don't sort the output.
    sortArgs=()
fi
typeset -a statusFilterArg=(); [ -z "$statusFilter" ] || statusFilterArg=(--diff-filter="$statusFilter")

deleteEmptyLines()
{
    sed -e '/^$/d'
}

showfiles()
{
    if [ "$isIncludeIntermediate" ]; then
	git-subdir-relativizer log "${prettyArgs[@]}" "${gitNameStatusArg[@]}" "${renameArgs[@]}" "${statusFilterArg[@]}" "${allargs[@]}" "${logRange[@]}" "$@"
    elif [ -n "$range" ]; then
	if [ ${#diffRange[@]} -gt 0 ]; then
	    printUsage "$0" >&2
	    exit 2
	fi
	# Source: http://stackoverflow.com/a/1552353/813602
	GIT_LOGLIMITTORANGECOMMAND_RANGE="$range" \
	    git-subdir-relativizer loglimit-to-range-command -2 \
		diff LIMITRANGE "${gitNameStatusArg[@]}" "${renameArgs[@]}" "${statusFilterArg[@]}" "${allargs[@]}" "${logRange[@]}" "$@"
    elif [ ${#diffRange[@]} -gt 0 ]; then
	# Source: http://stackoverflow.com/a/1552353/813602
	git-subdir-relativizer diff "${gitNameStatusArg[@]}" "${renameArgs[@]}" "${statusFilterArg[@]}" "${allargs[@]}" "${diffRange[@]}" "$@"
    else
	# Need to convert tags to commit ids, to avoid that "git show" also shows
	# details about the tag itself.
	for arg in "${allargs[@]}" "$@"
	do
	    argsWithResolvedCommitIds+=("$(git-commitid --no-error -- "$arg" || printf %s "$arg")")
	done
	git-subdir-relativizer loglimit-to-range-command -2 \
	    show LIMITRANGE "${prettyArgs[@]}" "${gitNameStatusArg[@]}" "${renameArgs[@]}" "${statusFilterArg[@]}" "${argsWithResolvedCommitIds[@]}"
    fi
}

eval 'showfiles "$@"' \
    "${sortArgs:+| sort}" '"${sortArgs[@]}"' \
    '| deleteEmptyLines' \
    "${pager:+|}" '"${pager[@]}"'
