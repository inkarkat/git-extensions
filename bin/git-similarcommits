#!/bin/bash

LONGUSAGE=
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    $LONGUSAGE cat <<HELPTEXT
Print the titles of commits in RANGE1 and RANGE2 that look similar (based on
identical commit message titles).
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" 'RANGE1 RANGE2 [--] [<pathspec>...] [-?|-h|--help]'
    $LONGUSAGE echo
    $LONGUSAGE cat <<HELPTEXT
Count the titles of commits in RANGE1 and RANGE2 that look similar.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '-c|--count RANGE1 RANGE2 [--] [<pathspec>...]'
    $LONGUSAGE echo
    $LONGUSAGE cat <<HELPTEXT
Test whether the number of commits in RANGE1 and RANGE2 that look similar is
greater / smaller than N.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '-g|--greater|-s|--smaller|-lt|-le|-eq|-ne|-ge|-gt N RANGE1 RANGE2 [--] [<pathspec>...]'
}
printShortUsage()
{
    LONGUSAGE=: printLongUsage "$1"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}

typeset -a pager=("${PAGER:-less}" --RAW-CONTROL-CHARS); [ -t 1 ] || pager=()
typeset -a counter=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--no-color|--color=*)
			shift;;
	--color)	shift; shift;;
	--count|-c)	shift; counter=(wc --lines); pager=();;
	--greater|-g|--smaller|-s|-lt|-le|-eq|-ne|-ge|-gt)
			counter=(count "$1" "$2"); pager=(); shift; shift;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -lt 2 ]; then
    printUsage "$0" >&2
    exit 2
fi
range1="$1"; shift
range2="$1"; shift

obtainSimilarCommits()
{
    comm -12 \
	<(git l "$range1" "$@" | sort --unique) \
	<(git l "$range2" "$@" | sort --unique)
}

eval 'obtainSimilarCommits' \
    "${counter:+|}" '"${counter[@]}"' \
    "${pager:+|}" '"${pager[@]}"'
