#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Rebase my commits on top of the stable branch.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[REBASE-ARGS ...] [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

exec git-wrapper rebase "$@" stable
