#!/bin/bash
set -o pipefail

typeset -a pager=("${PAGER:-less}" --RAW-CONTROL-CHARS); [ -t 1 ] || pager=()

LONGUSAGE=
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    $LONGUSAGE cat <<HELPTEXT
Extract all commit trailers for keys that are defined in the Git configuration
from the (single!) commit message.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: git lo1 [<log-options>] [<revision-range>] [[--] <pathspec>...] | %q %s\n' "$(basename "$1")" '--parse'
    $LONGUSAGE echo
    $LONGUSAGE cat <<HELPTEXT
Extract all unique commit trailers that are defined in the Git configuration
from the input.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: git lo [<log-options>] [<revision-range>] [[--] <pathspec>...] | %q %s\n' "$(basename "$1")" '--extract'
    $LONGUSAGE echo
    $LONGUSAGE cat <<HELPTEXT
Remove all commit trailers for keys that are defined in the Git configuration
from the input.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: git lo [<log-options>] [<revision-range>] [[--] <pathspec>...] | %q %s\n' "$(basename "$1")" '--remove'
}
printShortUsage()
{
    LONGUSAGE=: printLongUsage "$1"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}

action=printUsage
case "$1" in
    --help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
    --parse|--extract|--remove)
			action="${1#--}"; shift;;
esac
if [ $# -ne 0 ]; then
    printUsage "$0" >&2
    exit 2
fi

parse()
{
    git interpret-trailers --parse --no-divider \
	| sed -ne "/${trailerExpr:?}/p"
}

extract()
{
    sed -ne "/${trailerExpr:?}/p" \
	| sort --unique
}

remove()
{
    exec sed -e :a -e '/^[[:space:]]*\('"${trailerExpr//^/\\n}"'[^\n]*\)*\n*$/{ $d; /\n$/{ s/.*//; p; d; }; N; ba; }' -e 'P; D'
}

trailerExpr="$(git-trailer-keys --as-regexp)" || exit 0
eval '$action "$@"' \
    "${pager:+|}" '"${pager[@]}"'
