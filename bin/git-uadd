#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Add upstream repository (read-only) and fetch it.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[URL] [-?|-h|--help]'
}
case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac
userRepo=
case $# in
    0)	userRepo="$(hub-urepo)" || exit $?
	if hub-canpush "$userRepo"; then
	    pushNote="you can push to this repo"
	    url="$(hub-urepo --ssl)" || exit $?
	else
	    pushNote='read-only'
	    url="$(hub-urepo --remote)" || exit $?
	fi
	printf 'Upstream is %s; (%s)\n' "$url" "$pushNote"
	;;
    1)	url="${1:?}"; shift;;
    *)	printUsage "$0" >&2
	exit 2
	;;
esac

git remote add -f upstream "$url" || exit $?
if [ -z "$userRepo" ] && ! hub-ucanpush; then
    git-remote-setreadonly upstream \
	&& echo "Note: Made upstream read-only; your user doesn't have push permission."
fi
git-rderelict upstream --offer --no-fetch
