#!/bin/bash

LONGUSAGE=
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    $LONGUSAGE cat <<HELPTEXT
Cancel the last / N commit(s) / up to and including REVISION; keep working copy
and index.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-n N|--count N|-r|--revision REVISION] [--first-parent|--unmerge|--parent-number N] [-?|-h|--help]'
    $LONGUSAGE echo
    $LONGUSAGE cat <<HELPTEXT
Remove <pathspec>... / selected hunks from the last commit. Those changes will
then be in the working copy; the index won't be touched.
HELPTEXT
    $LONGUSAGE echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[-p|--patch] [--] <pathspec>...'
    printf 'Usage: %q %s\n' "$(basename "$1")" '-p|--patch [--] [<pathspec>...]'
}
printShortUsage()
{
    LONGUSAGE=: printLongUsage "$1"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}

typeset -a resetToCommitArgs=()
typeset -a resetArgs=()
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--no-color|--color=*)
			shift;;
	--color)	shift; shift;;
	--patch|-p)	resetArgs+=("$1"); shift;;
	--count|-n|--revision|-r|--parent-number)
			resetToCommitArgs+=("$1" "${2:?}"); shift; shift;;
	--first-parent|--unmerge)
			resetToCommitArgs+=("$1"); shift;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -gt 0 ]; then
    if [ ${#resetToCommitArgs[@]} -gt 0 ]; then
	echo 'ERROR: Cannot combine [-n N|--count N|-r|--revision REVISION] [--first-parent|--unmerge|--parent-number N] with <pathspec>...'
	echo
	printUsage "$0"
	exit 2
    elif git-ismerge; then
	echo 'ERROR: Cannot remove <pathspec>... from a merge commit.'
	exit 1
    fi
fi >&2

set -e
git-resetToCommit --soft "${resetToCommitArgs[@]}"
[ $# -eq 0 ] && [ ${#resetArgs[@]} -eq 0 ] && exit 0

git reset "${resetArgs[@]}" HEAD -- "$@"	# Note: This won't fail even if all <pathspec>... do not exist.
git commit --reuse-message ORIG_HEAD
