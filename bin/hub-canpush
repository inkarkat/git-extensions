#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Check whether the current / passed USER is allowed to push to OWNER/REPO.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" 'OWNER/REPO [USER] [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

case $# in
    1)	userRepo="${1:?}"; shift; user="$(git me-in-github)" || exit 3;;
    2)	userRepo="${1:?}"; shift; user="${1:?}"; shift;;
    *)	printUsage "$0"; exit 2;;
esac >&2

apiCall()
{
    gh api "repos/${userRepo:?}/collaborators/${user:?}/permission" --jq '.user.permissions.push' \
	2> >(grep --invert-match 'Must have push access to view collaborator permission' >&2)
}

result="$(apiCall "$@")" || exit 1
[ "$result" = 'true' ]
