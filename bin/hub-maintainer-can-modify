#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Check whether maintainers are allowed to modify the pull request.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[<number> | <url> | <branch>] [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

result="$(gh pr view --json maintainerCanModify --template '{{.maintainerCanModify}}' "$@")" || exit 3
[ "$result" = 'true' ]
