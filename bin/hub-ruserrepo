#!/bin/bash

printUsage()
{
    hub-userrepo --help 2>&1 | sed \
	-e "1s#^.*\$#Print the user/repository part and a possible issue / pull request ID of ${remote:-REMOTE}.#" \
	-e '2b removeFirstParagraphLoop' \
	-e '/^ *\(--fallback-guess\)/b removeOptionLoop' \
	-e '/^Usage:$/N' -e '/\(^\|\n\)Usage: */{ s/\(^\|\n\)\(Usage: *\)\?\(\([^ |]\+ \)*\(| \)\?\)hub-userrepo /\1\2\3'"$(basename "$1") ${remote:-REMOTE}"' /; s/ \[--fallback-guess|URL\]//; }' \
	-e b -e :removeFirstParagraphLoop -e '{ /\(^\|\n\)$/{ s/^\(.*\n\)\?//; b; }; N; b removeFirstParagraphLoop; }' \
	-e b -e :removeOptionLoop -e '{ /\n *\(--fallback-guess\)[^\n]*$/{ N; b removeOptionLoop; }; $s/$/\n/; /\n *--[^\n]*$\|\n[^	 ]\|\n$/{ s/^\(.*\n\)\?//; b; }; N; b removeOptionLoop; }'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

remote="${1:?}"; shift

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

remoteUrl="$(git-remote-url "$remote")" \
    && exec hub-userrepo "$@" "$remoteUrl"
